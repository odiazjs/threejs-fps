# AWS credentials (never commit this file)

AWS_REGION=us-east-1

AWS_ACCESS_KEY_ID=your_access_key_id

AWS_SECRET_ACCESS_KEY=your_secret_access_key



# Cognito User Pool app client (public client — no client secret unless you created one)

COGNITO_USER_POOL_ID=your_user_pool_id

COGNITO_CLIENT_ID=your_app_client_id

# COGNITO_CLIENT_SECRET=only_if_using_confidential_client



# Server port

PORT=4001



# Browser origin(s) allowed to call /api (comma-separated for multiple)
# Local dev:
CORS_ORIGIN=http://localhost:5173
# Production example (set on Render server service):
# CORS_ORIGIN=https://threejs-fps-client.onrender.com
# Both local + production:
# CORS_ORIGIN=http://localhost:5173,https://threejs-fps-client.onrender.com



# --- PostgreSQL (Render provides DATABASE_URL on the web service) ---

# Preferred: paste the internal or external connection string from Render.

DATABASE_URL=postgresql://user:password@host:5432/database_name



# Optional fallback if DATABASE_URL is not set (local dev):

# DB_HOST=localhost

# DB_PORT=5432

# DB_USER=postgres

# DB_PASSWORD=postgres

# DB_NAME=threejs_fps



# SSL: auto-detected from DATABASE_URL sslmode= or non-local DB_HOST.

# Force on/off if needed:

# DB_SSL=true



# Run `npm run db:migrate` before start on Render, or set:

# MIGRATE_ON_START=true



# --- Lemon Squeezy (plasma mineral pack purchases) ---
# Never expose these to the Vite client. Create 3 one-time variants in the
# Lemon Squeezy dashboard matching pack_1k / pack_10k / pack_100k.
#
# Wallet credit happens ONLY via the signed webhook:
#   POST https://<public-api-host>/api/webhooks/lemonsqueezy  (event: order_created)
#
# Local: `npm run dev --prefix server` starts an ngrok tunnel when enabled below.
# Paste the logged webhook URL into Lemon → Settings → Webhooks (Test mode).

LEMONSQUEEZY_API_KEY=your_lemon_squeezy_api_key
LEMONSQUEEZY_STORE_ID=your_store_id
LEMONSQUEEZY_WEBHOOK_SECRET=your_webhook_signing_secret_max_40_chars
# Numeric Variant IDs from Lemon Squeezy (Products → variant → ID), NOT pack_1k.
LEMONSQUEEZY_VARIANT_PACK_1K=123456
LEMONSQUEEZY_VARIANT_PACK_10K=123457
LEMONSQUEEZY_VARIANT_PACK_100K=123458
# Where Lemon redirects the browser after a successful checkout (lobby URL).
LEMONSQUEEZY_CHECKOUT_REDIRECT_URL=http://localhost:5173/lobby.html

# --- ngrok (local Lemon webhooks) ---
# https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_ENABLED=true
NGROK_AUTHTOKEN=your_ngrok_authtoken
# Optional reserved domain for a stable webhook URL across restarts:
# NGROK_DOMAIN=your-name.ngrok-free.app

# Offline / CI only — credits packs with no payment provider. Never enable in prod.
# PLASMA_PURCHASE_MOCK=true

