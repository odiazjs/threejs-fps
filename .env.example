# Colyseus server URL (read at Vite build time — set on Render static site).
# If unset or empty at build time, the browser derives https://<name>-server.onrender.com
# from the static site hostname when it ends with -client.onrender.com.
VITE_COLYSEUS_URL=http://localhost:4001
# Production example:
# VITE_COLYSEUS_URL=https://threejs-fps-server.onrender.com

# Set CORS_ORIGIN on the *server* service (not here). See server/.env.example.
